{
  "name": "fm-bridge",
  "displayName": "FM Bridge — FileMaker Script <-> Text",
  "description": "Local bridge between FileMaker's clipboard XML and readable .fmscript text: paste scripts as text (Ctrl+Alt+V), copy text back as FileMaker XML (Ctrl+Alt+B), with autocomplete for steps, functions, and your scripts. Learns step XML templates from real FileMaker copies.",
  "publisher": "kibiz",
  "version": "0.1.20",
  "license": "MIT",
  "engines": { "vscode": "^1.80.0" },
  "categories": ["Programming Languages", "Other"],
  "keywords": ["filemaker", "fmscript", "claris", "fmp", "fmxmlsnippet"],
  "repository": { "type": "git", "url": "https://github.com/KiBiz-Systems/FMBridge.git" },
  "bugs": { "url": "https://github.com/KiBiz-Systems/FMBridge/issues" },
  "homepage": "https://github.com/KiBiz-Systems/FMBridge#readme",
  "main": "./extension.js",
  "scripts": {
    "test": "node test/roundtrip.test.js",
    "package": "npx --yes @vscode/vsce package",
    "install-ide": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install.ps1",
    "install-ide:mac": "bash scripts/install.sh",
    "sync-templates": "node scripts/sync-templates.js",
    "deploy": "npm run sync-templates && npm test && npm run package && npm run install-ide",
    "deploy:mac": "npm run sync-templates && npm test && npm run package && npm run install-ide:mac"
  },
  "activationEvents": ["onLanguage:fmscript"],
  "contributes": {
    "languages": [
      {
        "id": "fmscript",
        "aliases": ["FileMaker Script"],
        "extensions": [".fmscript"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "fmscript",
        "scopeName": "source.fmscript",
        "path": "./syntaxes/fmscript.tmLanguage.json"
      }
    ],
    "commands": [
      { "command": "fmBridge.pasteFromFileMaker", "title": "FM Bridge: Paste FileMaker Clipboard as Script Text" },
      { "command": "fmBridge.copyAsFileMakerXml", "title": "FM Bridge: Copy as FileMaker XML" }
    ],
    "keybindings": [
      { "command": "fmBridge.pasteFromFileMaker", "key": "ctrl+alt+v", "mac": "cmd+alt+v", "when": "editorTextFocus" },
      { "command": "fmBridge.copyAsFileMakerXml", "key": "ctrl+alt+b", "mac": "cmd+alt+b", "when": "editorTextFocus && editorLangId == fmscript" }
    ]
  }
}
