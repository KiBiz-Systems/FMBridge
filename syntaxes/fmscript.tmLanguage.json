{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "FileMaker Script",
  "scopeName": "source.fmscript",
  "patterns": [
    { "include": "#raw-xml" },
    { "include": "#comment" },
    { "include": "#disabled" },
    { "include": "#step" }
  ],
  "repository": {
    "raw-xml": {
      "match": "^\\s*(#fmxml(?:64)?)\\s+(.*)$",
      "captures": {
        "1": { "name": "keyword.control.directive.fmscript" },
        "2": { "name": "string.unquoted.raw-xml.fmscript" }
      }
    },
    "comment": {
      "match": "^\\s*(#.*)$",
      "name": "comment.line.number-sign.fmscript"
    },
    "disabled": {
      "match": "^\\s*(//.*)$",
      "name": "comment.line.double-slash.disabled-step.fmscript"
    },
    "step": {
      "begin": "^\\s*([A-Z][\\w /,+-]*?)(?=\\s*\\[|\\s*$)",
      "beginCaptures": {
        "1": { "name": "keyword.control.step.fmscript" }
      },
      "end": "$",
      "patterns": [ { "include": "#step-args" } ]
    },
    "step-args": {
      "patterns": [
        { "include": "#string" },
        { "include": "#variable" },
        { "include": "#field-ref" },
        { "include": "#label" },
        { "include": "#function" },
        { "include": "#number" },
        { "include": "#operator" }
      ]
    },
    "string": {
      "begin": "\"",
      "end": "\"",
      "name": "string.quoted.double.fmscript",
      "patterns": [ { "match": "\\\\.", "name": "constant.character.escape.fmscript" } ]
    },
    "variable": {
      "match": "\\$\\$?[A-Za-z_][\\w.]*",
      "name": "variable.other.fmscript"
    },
    "field-ref": {
      "match": "\\b([A-Za-z_][\\w ]*?)(::)([A-Za-z_][\\w ]*)\\b",
      "captures": {
        "1": { "name": "entity.name.type.table.fmscript" },
        "2": { "name": "punctuation.separator.fmscript" },
        "3": { "name": "entity.name.tag.field.fmscript" }
      }
    },
    "label": {
      "match": "(?<=\\[|;)\\s*([A-Za-z][\\w ()/]*?):(?!:)",
      "captures": {
        "1": { "name": "entity.other.attribute-name.label.fmscript" }
      }
    },
    "function": {
      "match": "\\b([A-Za-z][\\w.]*)\\s*(?=\\()",
      "name": "support.function.fmscript"
    },
    "number": {
      "match": "\\b\\d+(\\.\\d+)?\\b",
      "name": "constant.numeric.fmscript"
    },
    "operator": {
      "match": "(&|=|≠|<>|≤|>=|≥|<=|<|>|\\+|-|\\*|/|\\b(and|or|not|xor)\\b)",
      "name": "keyword.operator.fmscript"
    }
  }
}
